{
    "version": "5.0.1",
    "description": "The Legend of Zelda: Majora's Mask PC port",
    "homepage": "https://github.com/HarbourMasters/2ship2harkinian",
    "license": "CC0-1.0",
    "notes": [
        "ATTENTION: 2Ship2Harkinian requires specific n64 rom(s) of Majora's Mask to function.",
        "Place the rom(s) in $persist_dir.",
        "Learn more at http://2ship.equipment"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/HarbourMasters/2ship2harkinian/releases/download/5.0.1/2Ship-Battler-Bravo-Win64.zip",
            "hash": "a46664a01623ad5d7cc82d29a9889699f6a98c9501c7a959a089f34380c1f078"
        }
    },
    "pre_install": [
        "'2ship2harkinian.json', 'imgui.ini', 'mm.o2r' | % {",
        "   if (!(Test-Path \"$persist_dir\\$_\") -and !(Test-Path \"$dir\\$_\")) {",
        "      New-Item -ItemType File \"$dir\\$_\" | Out-Null",
        "   }",
        "}"
    ],
    "shortcuts": [
        [
            "2ship.exe",
            "The Legend of Zelda - Majora's Mask"
        ]
    ],
    "persist": [
        "mods",
        "Save",
        "2ship2harkinian.json",
        "imgui.ini",
        "mm.o2r"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/HarbourMasters/2ship2harkinian/releases/latest",
        "script": [
            "$release = Invoke-RestMethod $url",
            "$parts = $release.name -split '\\s+'",
            "return \"$($release.tag_name) $($parts[0]) $($parts[1])\""
        ],
        "regex": "(?<version>[\\d.]+) (?<majorName>\\w+) (?<minorName>\\w+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/HarbourMasters/2ship2harkinian/releases/download/$version/2Ship-$matchMajorname-$matchMinorname-Win64.zip"
            }
        }
    }
}
