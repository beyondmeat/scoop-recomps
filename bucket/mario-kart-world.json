{
    "version": "0.1.12",
    "description": "Mario Kart World PC recompilation",
    "homepage": "https://github.com/adriadam10/mkw-recomp",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/adriadam10/mkw-recomp/releases/download/v0.1.12/mkw-recomp-0.1.12-windows-x64.zip",
            "hash": "74e29001d2bf0d2e8d9c520014ced56f8cc02278f11dbced9e74f337ce267ca3",
            "extract_dir": "mkw-recomp"
        }
    },
    "shortcuts": [
        [
            "mkw.exe",
            "Mario Kart World"
        ]
    ],
    "persist": [
        "romfs",
        "exefs",
        "profile",
        "lang",
        "logs",
        "mkw.ini",
        "mkwgame.dll",
        "mkwgame.dll.pdb",
        "mkwgame.id",
        "pipeline-cache.bin",
        "pipeline-keys.bin",
        "setup-state.json",
        "setup-work",
        "sm86",
        "spirv"
    ],
    "pre_install": "$files = @('mkw.ini', 'mkwgame.dll', 'mkwgame.dll.pdb', 'mkwgame.id', 'pipeline-cache.bin', 'pipeline-keys.bin', 'setup-state.json'); foreach ($file in $files) { if (!(Test-Path \"$persist_dir\\$file\") -and !(Test-Path \"$dir\\$file\")) { New-Item -ItemType File \"$dir\\$file\" | Out-Null } }",
    "notes": "No game files are included. Follow the program instructions to install the game contents.",
    "checkver": {
        "url": "https://api.github.com/repos/adriadam10/mkw-recomp/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<v0>\\d{1})\\.(?<v1>\\d{1})\\.(?<v2>\\d{2})$",
        "replace": "${v0}.${v1}.${v2}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/adriadam10/mkw-recomp/releases/download/v$version/mkw-recomp-$version-windows-x64.zip"
            }
        }
    }
}
