{
    "version": "1.2.0",
    "description": "Star Fox (Nintendo Switch 2) static recompilation for Windows",
    "homepage": "https://github.com/SerenityG4K/SpaceAnimalsRecomp",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/SerenityG4K/SpaceAnimalsRecomp/releases/download/v1.2.0/SpaceAnimalsRecomp-1.2.0-windows.zip",
            "hash": "a868641fbf69267194e0083502dc62273bd5d74cf119eedfdef50799ad676143",
            "extract_dir": "SpaceAnimalsRecomp-1.2.0"
        }
    },
    "shortcuts": [
        [
            "lanceur.exe",
            "StarFox"
        ]
    ],
    "persist": [
        "lanceur.ini",
        "recomp",
        "tools",
        "work",
        "extracted"
    ],
    "pre_install": "if (!(Test-Path \"$persist_dir\\lanceur.ini\") -and !(Test-Path \"$dir\\lanceur.ini\")) { New-Item -ItemType File \"$dir\\lanceur.ini\" | Out-Null }",
    "notes": "No game files are included. Follow the program instructions to install the game contents.",
    "checkver": {
        "url": "https://api.github.com/repos/SerenityG4K/SpaceAnimalsRecomp/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "^v(?<v0>\\d{1})\\.(?<v1>\\d{1})\\.(?<v2>\\d{1})$",
        "replace": "${v0}.${v1}.${v2}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SerenityG4K/SpaceAnimalsRecomp/releases/download/v$version/SpaceAnimalsRecomp-$version-windows.zip",
                "extract_dir": "SpaceAnimalsRecomp-$version"
            }
        }
    }
}
